lookup dligDiscretionaryLigaturesinLatinlookup10 {
  lookupflag 0;
    sub \f \i  by \fi;
    sub \f \l  by \fl;
} dligDiscretionaryLigaturesinLatinlookup10;

lookup caseCaseSensitiveForms {
  lookupflag 0;
    sub \exclamdown by \exclamdown.case ;
    sub \questiondown by \questiondown.case ;
    sub \uni2E18 by \uni2E18.case ;
} caseCaseSensitiveForms;

feature locl {

 script cyrl;
     language SRB  exclude_dflt;
      lookup loclLocalizedFormsinCyrilliclookup1;

 script latn;
     language ISM  exclude_dflt;
      lookup loclLocalizedFormsinLatinlookup0;
     language KSM  exclude_dflt;
      lookup loclLocalizedFormsinLatinlookup0;
     language LSM  exclude_dflt;
      lookup loclLocalizedFormsinLatinlookup0;
     language NSM  exclude_dflt;
      lookup loclLocalizedFormsinLatinlookup0;
     language SKS  exclude_dflt;
      lookup loclLocalizedFormsinLatinlookup0;
     language SSM  exclude_dflt;
      lookup loclLocalizedFormsinLatinlookup0;
} locl;

feature ccmp {

 script cyrl;
     language dflt ;
      lookup ccmpGlyphCompositionDecompositionlookup0;
     language SRB  exclude_dflt;
      lookup ccmpGlyphCompositionDecompositionlookup0;

 script grek;
     language dflt ;
      lookup ccmpGlyphCompositionDecompositionlookup0;

 script latn;
     language dflt ;
      lookup ccmpGlyphCompositionDecompositionlookup0;
     language ISM  exclude_dflt;
      lookup ccmpGlyphCompositionDecompositionlookup0;
     language KSM  exclude_dflt;
      lookup ccmpGlyphCompositionDecompositionlookup0;
     language LSM  exclude_dflt;
      lookup ccmpGlyphCompositionDecompositionlookup0;
     language MOL  exclude_dflt;
      lookup ccmpGlyphCompositionDecompositionlookup0;
     language NSM  exclude_dflt;
      lookup ccmpGlyphCompositionDecompositionlookup0;
     language ROM  exclude_dflt;
      lookup ccmpGlyphCompositionDecompositionlookup0;
     language SKS  exclude_dflt;
      lookup ccmpGlyphCompositionDecompositionlookup0;
     language SSM  exclude_dflt;
      lookup ccmpGlyphCompositionDecompositionlookup0;
} ccmp;

feature fina {

 script arab;
     language dflt ;
      lookup finaTerminalFormsinArabiclookup3;
} fina;

feature medi {

 script arab;
     language dflt ;
      lookup mediMedialFormsinArabiclookup4;
} medi;

feature init {

 script arab;
     language dflt ;
      lookup initInitialFormsinArabiclookup5;
} init;

feature rlig {

 script arab;
     language dflt ;
      lookup rligRequiredLigaturesinArabiclookup6;
} rlig;

feature liga {

 script arab;
     language dflt ;
      lookup ligaStandardLigaturesinArabiclookup7;
} liga;

feature dlig {

 script latn;
     language dflt ;
      lookup dligDiscretionaryLigaturesinLatinlookup10;
     language ISM  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup10;
     language KSM  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup10;
     language LSM  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup10;
     language MOL  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup10;
     language NSM  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup10;
     language ROM  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup10;
     language SKS  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup10;
     language SSM  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup10;
} dlig;

feature case {

 script DFLT;
     language dflt ;
      lookup caseCaseSensitiveForms;

 script latn;
     language dflt ;
      lookup caseCaseSensitiveForms;
     language CAT  exclude_dflt;
      lookup caseCaseSensitiveForms;
     language ESP  exclude_dflt;
      lookup caseCaseSensitiveForms;
     language GAL  exclude_dflt;
      lookup caseCaseSensitiveForms;
} case;

# GPOS 


lookup mkmkMarktoMarkinArabiclookup0 {
  lookupflag RightToLeft;
  markClass [\uni0650 ] <anchor 616 0> @rtlbelowmark;
  pos mark [\uni0655 ] <anchor 624 -540> mark @rtlbelowmark;
} mkmkMarktoMarkinArabiclookup0;

lookup mkmkMarktoMarkinArabiclookup1 {
  lookupflag RightToLeft;
  markClass [\uni064E \uni064F ] <anchor 605 1130> @rtlabovemark;
