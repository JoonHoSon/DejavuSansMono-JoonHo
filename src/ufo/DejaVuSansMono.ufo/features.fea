feature mkmk {

 script arab;
     language dflt ;
      lookup mkmkMarktoMarkinArabiclookup0;
      lookup mkmkMarktoMarkinArabiclookup1;
} mkmk;

feature mark {

 script arab;
     language dflt ;
      lookup markMarkPositioninginArabiclookup2;
      lookup markMarkPositioninginArabiclookup3;
      lookup markMarkPositioninginArabiclookup4;
      lookup markMarkPositioninginArabiclookup5;

 script cyrl;
     language dflt ;
      lookup markMarktoBaseinBasic;
      lookup markZeroWidthMarksinBasic;
     language SRB  exclude_dflt;
      lookup markMarktoBaseinBasic;
      lookup markZeroWidthMarksinBasic;

 script grek;
     language dflt ;
      lookup markMarktoBaseinBasic;
      lookup markZeroWidthMarksinBasic;

 script lao ;
     language dflt ;
      lookup markMarkpositioninginLao;

 script latn;
     language dflt ;
      lookup markMarktoBaseinBasic;
      lookup markZeroWidthMarksinBasic;
     language ISM  exclude_dflt;
      lookup markMarktoBaseinBasic;
      lookup markZeroWidthMarksinBasic;
     language KSM  exclude_dflt;
      lookup markMarktoBaseinBasic;
      lookup markZeroWidthMarksinBasic;
     language LSM  exclude_dflt;
      lookup markMarktoBaseinBasic;
      lookup markZeroWidthMarksinBasic;
     language MOL  exclude_dflt;
      lookup markMarktoBaseinBasic;
      lookup markZeroWidthMarksinBasic;
     language NSM  exclude_dflt;
      lookup markMarktoBaseinBasic;
      lookup markZeroWidthMarksinBasic;
     language ROM  exclude_dflt;
      lookup markMarktoBaseinBasic;
      lookup markZeroWidthMarksinBasic;
     language SKS  exclude_dflt;
      lookup markMarktoBaseinBasic;
      lookup markZeroWidthMarksinBasic;
     language SSM  exclude_dflt;
      lookup markMarktoBaseinBasic;
      lookup markZeroWidthMarksinBasic;
} mark;

feature rtbd {

 script lao ;
     language dflt ;
      lookup rtbdMarkwidthinLao;
} rtbd;

