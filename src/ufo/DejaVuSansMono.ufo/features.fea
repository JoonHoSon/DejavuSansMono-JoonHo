languagesystem DFLT dflt;
languagesystem arab dflt;
languagesystem cyrl dflt;
languagesystem cyrl SRB ;
languagesystem grek dflt;
languagesystem lao  dflt;
languagesystem latn CAT ;
languagesystem latn dflt;
languagesystem latn ESP ;
languagesystem latn GAL ;
languagesystem latn ISM ;
languagesystem latn KSM ;
languagesystem latn LSM ;
languagesystem latn MOL ;
languagesystem latn NSM ;
languagesystem latn ROM ;
languagesystem latn SKS ;
languagesystem latn SSM ;


# GSUB 


lookup loclLocalizedFormsinLatinlookup0 {
  lookupflag 0;
    sub \Eng by \Eng.alt ;
} loclLocalizedFormsinLatinlookup0;

lookup SingleSubstitutionDotlessForm {
  lookupflag 0;
    sub \i by \dotlessi ;
    sub \j by \dotlessj ;
} SingleSubstitutionDotlessForm;

lookup ccmpGlyphCompositionDecompositionlookup0 {
  lookupflag 0;
    @cc1_match_1 = [\i \j ];
    @cc1_match_2 = [\gravecomb \acutecomb \uni0302 \tildecomb \uni0304 \uni0305 \uni0306 \uni0307 
	\uni0308 \hookabovecomb \uni030A \uni030B \uni030C \uni030D \uni030E 
	\uni030F \uni0310 \uni0311 \uni0312 \uni0313 \uni0314 \uni0315 \uni033D 
	\uni033E \uni033F \uni0343 \uni0374 ];
    @cc1_match_3 = [\uni0316 \uni0317 \uni0318 \uni0319 \uni031C \uni031D \uni031E \uni031F \uni0320 
	\dotbelowcomb \uni0324 \uni0325 \uni0326 \uni0327 \uni0328 \uni0329 
	\uni032A \uni032B \uni032C \uni032D \uni032E \uni032F \uni0330 \uni0331 
	\uni0332 \uni0333 \uni0339 \uni033A \uni033B \uni033C ];
    @cc1_ahead_1 = [\i \j ];
    @cc1_ahead_2 = [\gravecomb \acutecomb \uni0302 \tildecomb \uni0304 \uni0305 \uni0306 \uni0307 
	\uni0308 \hookabovecomb \uni030A \uni030B \uni030C \uni030D \uni030E 
	\uni030F \uni0310 \uni0311 \uni0312 \uni0313 \uni0314 \uni0315 \uni033D 
	\uni033E \uni033F \uni0343 \uni0374 ];
    @cc1_ahead_3 = [\uni0316 \uni0317 \uni0318 \uni0319 \uni031C \uni031D \uni031E \uni031F \uni0320 
	\dotbelowcomb \uni0324 \uni0325 \uni0326 \uni0327 \uni0328 \uni0329 
	\uni032A \uni032B \uni032C \uni032D \uni032E \uni032F \uni0330 \uni0331 
	\uni0332 \uni0333 \uni0339 \uni033A \uni033B \uni033C ];
    sub @cc1_match_1'lookup SingleSubstitutionDotlessForm  @cc1_ahead_2 ;
    sub @cc1_match_1'lookup SingleSubstitutionDotlessForm  @cc1_ahead_3 @cc1_ahead_2 ;
    sub @cc1_match_1'lookup SingleSubstitutionDotlessForm  @cc1_ahead_3 @cc1_ahead_3 @cc1_ahead_2 ;
} ccmpGlyphCompositionDecompositionlookup0;

