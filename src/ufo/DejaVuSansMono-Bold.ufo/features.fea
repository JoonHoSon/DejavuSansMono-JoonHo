  lookupflag RightToLeft;
  markClass [\uni0650 ] <anchor 618 -6> @rtlbelowmark;
  pos mark [\uni0655 ] <anchor 618 -620> mark @rtlbelowmark;
} mkmkMarktoMarkinArabiclookup0;

