languagesystem latn ROM ;
languagesystem latn SKS ;
languagesystem latn SSM ;


# GSUB 


lookup loclLocalizedFormsinLatinlookup0 {
  lookupflag 0;
    sub \Eng by \Eng.alt ;
} loclLocalizedFormsinLatinlookup0;

lookup loclLocalizedFormsinCyrilliclookup0 {
  lookupflag 0;
    sub \g by \uniF6C5 ;
    sub \uni0431 by \uniF6C5 ;
} loclLocalizedFormsinCyrilliclookup0;

