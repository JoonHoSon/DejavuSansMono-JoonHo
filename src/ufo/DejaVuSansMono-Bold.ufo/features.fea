      lookup markMarkPositioninglookup7;
      lookup markMarkPositioninglookup8;

 script grek;
     language dflt ;
      lookup markMarkPositioninglookup6;
      lookup markMarkPositioninglookup7;
      lookup markMarkPositioninglookup8;

 script lao ;
     language dflt ;
      lookup markMarkpositioninginLao;

