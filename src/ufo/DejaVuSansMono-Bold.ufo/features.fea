lookup rligRequiredLigaturesinArabiclookup5 {
  lookupflag RightToLeft IgnoreMarks;
    sub \uniFEDF \uniFE8E  by \uniFEFB;
    sub \uniFEE0 \uniFE8E  by \uniFEFC;
} rligRequiredLigaturesinArabiclookup5;

lookup ligaStandardLigaturesinArabiclookup6 {
  lookupflag RightToLeft IgnoreMarks;
    sub \uniFEDF \uniFE82  by \uniFEF5;
    sub \uniFEE0 \uniFE82  by \uniFEF6;
    sub \uniFEDF \uniFE84  by \uniFEF7;
    sub \uniFEE0 \uniFE84  by \uniFEF8;
    sub \uniFEDF \uniFE88  by \uniFEF9;
    sub \uniFEE0 \uniFE88  by \uniFEFA;
} ligaStandardLigaturesinArabiclookup6;

lookup dligDiscretionaryLigaturesinLatinlookup9 {
  lookupflag 0;
    sub \f \i  by \fi;
    sub \f \l  by \fl;
} dligDiscretionaryLigaturesinLatinlookup9;

lookup caseCaseSensitiveForms {
  lookupflag 0;
    sub \exclamdown by \exclamdown.case ;
    sub \questiondown by \questiondown.case ;
    sub \uni2E18 by \uni2E18.case ;
} caseCaseSensitiveForms;

feature locl {

 script cyrl;
     language SRB  exclude_dflt;
      lookup loclLocalizedFormsinCyrilliclookup0;

 script latn;
     language ISM  exclude_dflt;
      lookup loclLocalizedFormsinLatinlookup0;
     language KSM  exclude_dflt;
      lookup loclLocalizedFormsinLatinlookup0;
     language LSM  exclude_dflt;
      lookup loclLocalizedFormsinLatinlookup0;
     language NSM  exclude_dflt;
      lookup loclLocalizedFormsinLatinlookup0;
     language SKS  exclude_dflt;
      lookup loclLocalizedFormsinLatinlookup0;
     language SSM  exclude_dflt;
      lookup loclLocalizedFormsinLatinlookup0;
} locl;

feature fina {

 script arab;
     language dflt ;
      lookup finaTerminalFormsinArabiclookup2;
} fina;

feature medi {

 script arab;
     language dflt ;
      lookup mediMedialFormsinArabiclookup3;
} medi;

feature init {

 script arab;
     language dflt ;
      lookup initInitialFormsinArabiclookup4;
} init;

feature rlig {

 script arab;
     language dflt ;
      lookup rligRequiredLigaturesinArabiclookup5;
} rlig;

feature liga {

 script arab;
     language dflt ;
      lookup ligaStandardLigaturesinArabiclookup6;
} liga;

feature dlig {

 script latn;
     language dflt ;
      lookup dligDiscretionaryLigaturesinLatinlookup9;
     language ISM  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup9;
     language KSM  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup9;
     language LSM  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup9;
     language MOL  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup9;
     language NSM  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup9;
     language ROM  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup9;
     language SKS  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup9;
     language SSM  exclude_dflt;
      lookup dligDiscretionaryLigaturesinLatinlookup9;
} dlig;

feature case {

 script DFLT;
     language dflt ;
      lookup caseCaseSensitiveForms;

 script latn;
     language dflt ;
      lookup caseCaseSensitiveForms;
     language CAT  exclude_dflt;
      lookup caseCaseSensitiveForms;
     language ESP  exclude_dflt;
      lookup caseCaseSensitiveForms;
     language GAL  exclude_dflt;
      lookup caseCaseSensitiveForms;
} case;

